func mix_text(name: String, value) -> void:
	if value is String or value is StringName or value is NodePath:
		mix(name, String(value).to_utf8_buffer())
	elif value is Array or value is PackedStringArray:
		for v in value:
			mix_text(name, v)
	else:
		mix(name, value)


