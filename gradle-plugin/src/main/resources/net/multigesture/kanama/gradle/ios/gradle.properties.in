# Written by the Kanama Gradle plugin (buildIosScripts) on every run. Do not edit.
# Kotlin/Native compiles and links inside this build's Gradle daemon. The release link of Kanama's
# Godot API needs a large heap (@HEAP_NOTE@); the daemon stops 10 minutes after the last build
# instead of holding that memory for hours.
org.gradle.jvmargs=-Xmx@HEAP@ -XX:MaxMetaspaceSize=1g -Dfile.encoding=UTF-8
org.gradle.daemon.idletimeout=600000
