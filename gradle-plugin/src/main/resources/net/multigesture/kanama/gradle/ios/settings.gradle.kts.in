// Written by the Kanama Gradle plugin (buildIosScripts) on every run. Do not edit.
pluginManagement {
    repositories {
        gradlePluginPortal()
        mavenCentral()
    }
}

// The project's addon is the only place a Kanama artifact can come from: no mavenLocal(), and no
// other repository may serve net.multigesture artifacts. Maven Central serves the rest.
dependencyResolutionManagement {
    repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
    repositories {
        exclusiveContent {
            forRepository { maven { name = "kanamaAddon"; url = uri("@KANAMA_MAVEN@") } }
            filter { includeGroupByRegex("net\\.multigesture(\\..*)?") }
        }
        mavenCentral()
    }
}

rootProject.name = "@INNER_PROJECT@"
