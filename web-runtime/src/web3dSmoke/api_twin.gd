extends Node
## Harness-only (task 125 P5): what the Web API exercise's generic oracle cannot reach by itself
## (ApiExerciseProbe, generated by scripts/generate_web_exercise.py). The generic tier calls a method
## on an object it holds a handle to: these hand it the engine singletons, seed the global random
## generator the utility rows read, and remove the one file a row saves.

func singleton(singleton_name: String) -> Object:
	return Engine.get_singleton(singleton_name)

func reseed(value: int) -> void:
	seed(value)

func seeded_randf(value: int) -> float:
	seed(value)
	return randf()

func seeded_randi(value: int) -> int:
	seed(value)
	return randi()

func remove_file(path: String) -> int:
	return DirAccess.remove_absolute(path)
